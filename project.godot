; Engine configuration file.
; StimPad: Audio Sensory Fidget

config_version=5

[application]

config/name="StimPad"
config/description="Audio sensory fidget soundboard for neurodivergent users."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://assets/branding/icon_1024.png"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

SoundCatalog="*res://scripts/autoload/sound_catalog.gd"
AudioController="*res://scripts/autoload/audio_controller.gd"
LocalPrefs="*res://scripts/autoload/local_prefs.gd"
Entitlements="*res://scripts/autoload/entitlements.gd"
AdsService="*res://scripts/autoload/ads_service.gd"
IAPService="*res://scripts/autoload/iap_service.gd"
AnalyticsService="*res://scripts/autoload/analytics_service.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/theme/stimpad_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray()

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[editor_plugins]

enabled=PackedStringArray("res://addons/AdmobPlugin/plugin.cfg")
