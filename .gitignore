# Godot
.godot/
*.import
!assets/**/*.png.import
!assets/**/*.webp.import
export.cfg
export_presets.cfg.bak
_tmp/

# Build artifacts (repo-root export output only; android/build is the Gradle template)
/build/*
!/build/.gdignore
/_exclude/*
!/_exclude/.gdignore
*.apk
*.aab
*.ipa
/StimPad.aab
/StimPad.apk
StimPad-privacy/
android/build/src/debug/
# Play bundles (*.aab) are ignored above. AdMob plugin libraries are .aar and must stay:
# addons/AdmobPlugin/bin/debug/AdmobPlugin-debug.aar
# addons/AdmobPlugin/bin/release/AdmobPlugin-release.aar
!addons/AdmobPlugin/bin/**/*.aar
*.xcarchive
*.dSYM.zip

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets (never commit)
GoogleService-Info.plist
ios/GoogleService-Info.plist
addons/GodotFirebaseiOS/GoogleService-Info.plist
*.p12
*.mobileprovision
*.keystore
*.jks
keys/
android/*.keystore
.godot/export_credentials.cfg
google-services.json
android/build/google-services.json

# Godot Android template. Commit only the overrides we maintain.
android/build/**
!android/build/.gdignore
!android/build/build.gradle
!android/build/config.gradle
!android/build/settings.gradle
!android/build/gradle.properties
!android/build/proguard-rules.pro
!android/build/res/
!android/build/res/**
!android/build/src/
!android/build/src/**
.env
.env.*

# IDE
.vscode/
.idea/

# Temp / reference downloads
docs-ref-*
*-ref.yml
*.log
_tmp_firebase/
_tmp/
assets/audio/_tmp*/
assets/audio/_wav_masters/**
!assets/audio/_wav_masters/
!assets/audio/_wav_masters/.gdignore
assets/ui/_theme_previews/
assets/branding/concepts/

# Firebase iOS plugin frameworks are huge (~300MB) + Windows MAX_PATH issues.
# Install via scripts/setup_ios_firebase.sh (CI does this automatically).
addons/GodotFirebaseiOS/

# Local Firebase configs (use CI secrets or local copy)
# ios/framework and ios/plugins are committed with AdmobPlugin

node_modules/
package-lock.json

