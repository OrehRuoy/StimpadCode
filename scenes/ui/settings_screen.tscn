[gd_scene load_steps=2 format=3 uid="uid://stimpad_settings"]

[ext_resource type="Script" path="res://scripts/ui/settings_screen.gd" id="1"]

[node name="SettingsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Settings"

[node name="PlusStatus" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "StimPad Plus: Not purchased"

[node name="FxToggle" type="CheckButton" parent="Margin/VBox"]
layout_mode = 2
button_pressed = true
text = "Visual effects while playing"

[node name="RestoreBtn" type="Button" parent="Margin/VBox"]
layout_mode = 2
text = "Restore Purchases"

[node name="CreditsBtn" type="Button" parent="Margin/VBox"]
layout_mode = 2
text = "Sound Credits"

[node name="CreditsPanel" type="Label" parent="Margin/VBox"]
visible = false
layout_mode = 2
autowrap_mode = 3
text = "Most bundled sounds sourced from Mixkit (Mixkit License, free commercial use). Generated noise tracks are CC0. See docs/SOUND_LICENSES.md in the repository."

[node name="PrivacyBtn" type="Button" parent="Margin/VBox"]
layout_mode = 2
text = "Privacy Policy"

[node name="VersionLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "StimPad v1.0.0"

[node name="BackBtn" type="Button" parent="Margin/VBox"]
layout_mode = 2
text = "Back"
